# URL da API Express. Local: http://localhost:3000 · Produção: https://<seu-servico>.onrender.com
VITE_API_URL=http://localhost:3000

# Dados fictícios e visualização das telas protegidas. Em produção, ambos false.
VITE_ENABLE_DEMO_DATA=false
VITE_PREVIEW_WITHOUT_AUTH=false

# Credenciais públicas do Supabase Auth. A chave anon/publishable pode ficar no frontend.
# Nunca coloque aqui a service_role ou senha do banco.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
