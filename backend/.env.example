# Conexão PostgreSQL do Supabase. Use o Session pooler (IPv4): Connect → Session pooler.
# Ex.: postgresql://postgres.<projeto>:<SENHA>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
# Nunca versionar o valor real.
DATABASE_URL=

# Validação de sessão: URL do projeto e chave PÚBLICA (publishable/anon). Não use a service_role.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Origens do frontend autorizadas no CORS (separadas por vírgula).
# Local: http://localhost:8443 · Produção: https://<seu-app>.vercel.app
# Fora de produção (NODE_ENV != production), localhost e IPs de rede local também são aceitos.
FRONTEND_ORIGIN=
PORT=3000
# Em produção (Render): NODE_ENV=production
NODE_ENV=
